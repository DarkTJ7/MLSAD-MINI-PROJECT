# Optional native reproduction; all endpoints remain localhost.
REDIS_URL=redis://127.0.0.1:18764/0
# Set this only if this helper should start a previously installed Redis executable.
REDIS_EXECUTABLE=
# Model selection: MODEL_PROVIDER can be 'stub', 'local', or 'gemini'
MODEL_PROVIDER=stub
MODEL_MODE=stub
MODEL_URL=http://127.0.0.1:18765/v1/chat/completions
MODEL_ID=local-planner
# Gemini configuration (used when MODEL_PROVIDER=gemini or MODEL_MODE=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RESEARCH_PROMPT_VARIANT=v5b
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=8
INPUT_USD_PER_MILLION=0
OUTPUT_USD_PER_MILLION=0
SAFETY_URL=http://127.0.0.1:18763
SAFETY_REQUIRED=true
SAFETY_TIMEOUT_SECONDS=15
MODEL_ASSET_DIR=.native_runtime/models
MODEL_MANIFEST_PATH=corpus/model_manifest.json
NATIVE_START_SAFETY=true
STUB_DELAY_SECONDS=0.35
STUB_FAIL=false
RUN_TIMEOUT_SECONDS=45
RATE_LIMIT_PER_MINUTE=10000
QUALITY_SAMPLE_RATE=0.25
API_PORT=18766
DEMO_BASE_URL=http://127.0.0.1:18766
OTEL_EXPORTER_OTLP_ENDPOINT=
